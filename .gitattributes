# Force LF for all text files
* text eol=lf

# Explicitly mark specific file types as text to ensure they get normalized
*.sh text eol=lf
*.py text eol=lf
*.txt text eol=lf
*.ipynb text eol=lf

# Store notebooks without their outputs. The working copy keeps its rendered
# figures; only what git records is stripped. The filter itself lives in
# .git/config, which is not tracked, so each clone must run once:
#     python tools/nbstrip.py --install
# Until that is run, notebooks are committed unchanged (git ignores an
# unconfigured filter), so this line is safe for anyone who has not set it up.
*.ipynb filter=nbstrip

# Optional: Ensure binaries are not touched
*.pdf binary
*.png binary
*.jpg binary
*.pkl binary
*.npz binary
*.nc binary
*.hds binary
*.cbc binary
*.grb binary
*.ucn binary

# D-Flow FM / SWMM binary outputs
*.cache binary
*.out binary

# Executables and libraries
*.exe binary
*.dll binary

# Archives and office documents
*.zip binary
*.pptx binary

# Shapefile binary components (leave *.prj/*.cpg as text)
*.shp binary
*.shx binary
*.dbf binary
*.sbn binary
*.sbx binary
