% The leakage limit a newly constructed gravity sewer has to meet, and the source
% the pipe-wall leakance is anchored to. Section 33.94 of the 2014 edition states
% the limit in both customary and SI form -- "100 gallons per inch of pipe diameter
% per mile per day [9 L/(mm of pipe diameter*km*d)]" -- which is where the unit the
% infiltration rates are reported in comes from. Entered under the board's short
% name, which is what it is cited by: the full corporate author -- "of State and
% Provincial Public Health and Environmental Managers" -- runs to fifteen words and
% would fill an in-text citation on its own. It is carried in the note instead, so
% the reference list still identifies the body completely.
@book{glumrb2014wastewater,
  author    = {{Great Lakes--Upper Mississippi River Board}},
  title     = {Recommended Standards for Wastewater Facilities},
  edition   = {2014},
  publisher = {{Health Research, Inc., Health Education Services Division}},
  address   = {Albany, NY},
  year      = {2014},
  note      = {A report of the Wastewater Committee of the Great Lakes--Upper
               Mississippi River Board of State and Provincial Public Health and
               Environmental Managers; commonly cited as the Ten States Standards}
}

% Table 3-8, "Infiltration/Inflow Allowances for Various Sewer Agencies", is the
