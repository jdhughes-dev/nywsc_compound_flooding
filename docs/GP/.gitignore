# LaTeX build artifacts. Everything here is regenerated by
#   pdflatex gp_coupling && bibtex gp_coupling && pdflatex gp_coupling x2
*.aux
*.bbl
*.blg
*.log
*.out
*.spl
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz

# The built PDF is a derived file. Un-ignore it if a compiled draft should travel
# with the repository for co-authors who do not build locally.
*.pdf
