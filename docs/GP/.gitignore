# LaTeX build artifacts. Everything here is regenerated by
#   pdflatex gp_coupling && bibtex gp_coupling && pdflatex gp_coupling x2
*.aux
*.bbl
*.blg
*.log
*.out
*.spl
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz

# The built manuscript is a derived file. Named explicitly rather than as *.pdf:
# a blanket rule would also swallow figures/, whose PDFs are source as far as the
# repository is concerned -- co-authors need them to build the document.
gp_coupling.pdf

# The repository root ignores "figures*/", which is right for the notebook output
# directories but wrong here: these figures are manuscript source. Git cannot
# re-include a file whose parent directory is excluded, so the directory itself
# has to be un-ignored, and a rule in this deeper file takes precedence over the
# root one.
!figures/
!figures/**

# Byte-compiled figure scripts
__pycache__/
