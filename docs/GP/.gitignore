# LaTeX build artifacts. Everything here is regenerated by
#   pdflatex Hughesetal_AWR_LISSCoupling && bibtex Hughesetal_AWR_LISSCoupling && pdflatex Hughesetal_AWR_LISSCoupling x2
*.aux
*.bbl
*.blg
*.log
*.out
*.spl
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz

# The built manuscript is a derived file. Named explicitly rather than as *.pdf:
# a blanket rule would also swallow figures/, whose PDFs are source as far as the
# repository is concerned -- co-authors need them to build the document.
Hughesetal_AWR_LISSCoupling.pdf

# Byte-compiled figure scripts
__pycache__/

# Submission copies of the figures, numbered as the document numbers them.
# Derived from figures/ by rebuild_manuscript.py --submission; not source.
submission/
