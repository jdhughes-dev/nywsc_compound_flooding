# PyCharm
#  JetBrains specific template is maintained in a separate 
JetBrains.gitignore that can
#  be found at 
https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For 
a more nuclear
#  option (not recommended) you can uncomment the following to ignore the 
entire idea folder.
#.idea/


# repo specific exclusions
run*/
dflowfm_dll/
license/
# Figures under notebooks*/ are regenerated by running the notebooks and are not
# tracked. Scoped to those directories rather than matching figures*/ anywhere:
# docs/*/figures holds manuscript source, which co-authors need to build the
# document.
notebook*/figures*/
animations*/
trash_*

Thumbs.db

modflow/port_jeff/*

swmm/greenport/*.out
swmm/greenport/*.rpt

swmm/gp/*.out
swmm/gp/*.rpt

# scenario results written by step2_run_coupled_models (dflow_tracer.nc alone is
# ~1.3 GB per coarse scenario); regenerate by re-running the scenario
results/

# Per-scenario run logs and the thermal/memory/disk samples taken alongside them.
# *.log above already catches the run logs; this adds logs/thermals.csv, which is
# the only other thing written there. Both are a record of one machine's runs --
# tens of megabytes per sweep, and meaningless on anyone else's -- so they stay
# local. run_scenario.py and run_sweep.py write them; the only reader is
# coupling_cost_data.py, which takes Figure 8's run times from the logs when they
# are present and from coupling_cost.nc when they are not.
logs/

# ad-hoc backups made before regenerating an input; git already has the original
*.bak

dflow-fm/coarse/tides/FlowFM_map.nc
dflow-fm/coarse/tides/FlowFM_map.nc

